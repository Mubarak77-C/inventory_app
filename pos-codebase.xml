COOKIE_JAR="/tmp/cookies.txt"

# 0. Authenticate session
curl -sf -c "$COOKIE_JAR" -L -X POST "$BASE_URL/login" \
  -d "username=cashier1&password=Cashier@1234" > /dev/null

# Helper to query item stock
get_stock() {
  local item_id="$1"
  docker-compose exec -T postgres psql -U my_user -d inventory_db -t -A \
    -c "SELECT stock_count FROM public.items WHERE id = ${item_id};"
}

echo "--- 1. Punch fresh PENDING order (item #3 qty=2) ---"
STOCK3_BEFORE=$(get_stock 3)
ORDER_ID=$(curl -sf -b "$COOKIE_JAR" -X POST "$BASE_URL/orders" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json" \
  -d "{\"idempotencyKey\":\"edge-edit-$(date +%s%N)\",\"items\":[{\"itemId\":3,\"quantity\":2}]}" \
  | node -e "const d = JSON.parse(require('fs').readFileSync(0,'utf8')); console.log(d.order ? d.order.id : '');")
echo "Created Order #$ORDER_ID | Item #3 stock before: $STOCK3_BEFORE -> after punch: $(get_stock 3)"

echo "--- 2. Decrease qty (2 -> 1) -> should restock +1 on item #3 ---"
curl -s -i -b "$COOKIE_JAR" -X PUT "$BASE_URL/orders/${ORDER_ID}/items" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json" \
  -d '{"items":[{"itemId":3,"quantity":1}],"reason":"Customer reduced qty to 1"}'
echo ""
echo "Item #3 stock after decrease: $(get_stock 3)"

echo "--- 3. Add item #1 (qty=1) alongside item #3 (qty=1) ---"
curl -s -i -b "$COOKIE_JAR" -X PUT "$BASE_URL/orders/${ORDER_ID}/items" \
  -H "Content-Type: application/json" \
/tmp/test_order_edit_edges.sh_edges.shs, changed_by, reason FROM public.order_status_history WHERE order_id = ${ORDER_ID} ORDER
