<!-- views/partials/header.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'Inventory App' %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <!-- Navigation Bar -->
    <nav
      class="bg-slate-800 text-white px-6 py-4 shadow-md flex items-center justify-between"
    >
      <div class="flex space-x-6 font-medium text-sm">
        <a href="/items" class="hover:text-indigo-300 transition"
          >📦 Inventory Dashboard</a
        >
        <a href="/items/new" class="hover:text-indigo-300 transition"
          >+ Add Item</a
        >
        <a href="/categories" class="hover:text-indigo-300 transition"
          >📂 Categories</a
        >
      </div>

      <a href="/items/restock-advisor" class="hover:text-indigo-300 transition"
        >🤖 AI Restock Advisor</a
      >
    </nav>
    <main class="max-w-6xl mx-auto px-4 py-6"></main>
  </body>
</html>
