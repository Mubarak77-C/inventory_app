<!-- views/restockAdvisor.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">

  <%- include('partials/header', { title: title }) %>

  <main class="max-w-4xl mx-auto px-4 py-8">
    
    <!-- Header & Action Buttons -->
    <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">🤖 AI Restock Advisor</h1>
        <p class="text-sm text-gray-500 mt-1">Automated purchasing insights powered by Gemini.</p>
      </div>
      <div class="flex items-center gap-3">
        <!-- Retry / Refresh Button -->
        <button onclick="window.location.reload();" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm transition flex items-center gap-1.5 cursor-pointer">
          🔄 Refresh AI Report
        </button>
        <!-- Back Button -->
        <a href="/items" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition">
          &larr; Dashboard
        </a>
      </div>
    </div>

    <!-- AI Report Card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-8">
      <h2 class="text-lg font-semibold text-indigo-600 mb-3">📋 Executive Restock Summary</h2>
      <div class="prose text-sm text-gray-700 whitespace-pre-line leading-relaxed bg-indigo-50/50 p-4 rounded-lg border border-indigo-100">
        <%= report %>
      </div>
    </div>

    <!-- Low Stock Items Breakdown Table -->
    <% if (lowStockItems && lowStockItems.length > 0) { %>
      <h2 class="text-lg font-semibold text-gray-900 mb-4">⚠️ Items Requiring Attention (<%= lowStockItems.length %>)</h2>
      <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Item Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Category</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Current Stock</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% lowStockItems.forEach(item => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= item.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= item.category_name || 'Uncategorized' %></td>
                <td class="px-6 py-4 text-sm font-semibold text-red-600"><%= item.stock_count %> left</td>
                <td class="px-6 py-4 text-sm text-gray-500">$<%= Number(item.price).toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>