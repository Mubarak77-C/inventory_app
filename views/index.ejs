<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Dashboard</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Inter Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">

  <%- include('partials/header', { title: 'Inventory Dashboard' }) %>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header Section with Title and Add Button -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">📦 Restaurant & Store Inventory</h1>
        <p class="text-sm text-gray-500 mt-1">Welcome to your operational dashboard.</p>
      </div>
      <a href="/items/new" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm transition">
        + Add New Item
      </a>
    </div>

    <% if (items && items.length > 0) { %>
      <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Category ID</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Stock</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% items.forEach(item => { %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= item.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= item.description || 'No description' %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <span class="px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">
                    <%= item.category_id %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$<%= Number(item.price).toFixed(2) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= item.stock_count %></td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
                  <a href="/items/<%= item.id %>/edit" class="text-indigo-600 hover:text-indigo-900">Edit</a>
                  <form action="/items/<%= item.id %>?_method=DELETE" method="POST" class="inline">
                    <button type="submit" class="text-red-600 hover:text-red-900 cursor-pointer" onclick="return confirm('Are you sure you want to delete this item?');">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <p class="text-gray-500 text-sm">No items found in inventory.</p>
        <a href="/items/new" class="mt-4 inline-block text-indigo-600 font-medium hover:underline text-sm">Create your first item &rarr;</a>
      </div>
    <% } %>

  </div>

  <%- include('partials/footer') %>
</body>
</html>