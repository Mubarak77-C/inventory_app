        <% } %>

      </div>
    </div>

    <!-- Summary Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Total Asset Value</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">
          $<%= typeof totalInventoryValue !== 'undefined' ? totalInventoryValue.toFixed(2) : '0.00' %>
        </p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Total Unique Items</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">
          <%= items ? items.length : 0 %>
        </p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">System Status</p>
        <p class="text-sm font-medium text-green-600 mt-2 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-green-500"></span> Operational
        </p>
      </div>
    </div>

    <!-- 📊 Analytics Charts Section -->
    <% if (typeof categoryData !== 'undefined' && categoryData.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        
        <!-- Bar Chart: Stock by Category -->
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <h3 class="text-sm font-semibold text-gray-800 mb-4 flex items-center gap-2">
            📊 Stock Units by Category
          </h3>
          <div class="relative h-64">
            <canvas id="stockBarChart"></canvas>
          </div>
        </div>

        <!-- Doughnut Chart: Asset Value Share -->
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <h3 class="text-sm font-semibold text-gray-800 mb-4 flex items-center gap-2">
            💰 Asset Valuation Share ($)
          </h3>
          <div class="relative h-64 flex justify-center">
            <canvas id="valueDoughnutChart"></canvas>
          </div>
        </div>

      </div>

      <!-- Chart.js Initialization Script -->
      <!-- Chart.js Initialization Script -->
      <script>
        // Safely parse category data passed from Express
        const categoryData = JSON.parse('<%- JSON.stringify(categoryData) %>');

        const labels = categoryData.map(c => c.name);
        const stockValues = categoryData.map(c => c.stock);
        const financialValues = categoryData.map(c => c.value);

        // 1. Stock Bar Chart
        const barCtx = document.getElementById('stockBarChart').getContext('2d');
        new Chart(barCtx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Total Stock Count',
              data: stockValues,
              backgroundColor: '#4f46e5',
              borderRadius: 6,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, grid: { color: '#f3f4f6' } },
              x: { grid: { display: false } }
            }
          }
        });

        // 2. Valuation Doughnut Chart
        const doughnutCtx = document.getElementById('valueDoughnutChart').getContext('2d');
        new Chart(doughnutCtx, {
          type: 'doughnut',
          data: {
            labels: labels,
            datasets: [{
              data: financialValues,
              backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'],
              borderWidth: 2,
              borderColor: '#ffffff'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
            }
          }
        });
      </script>
    <% } %>

    <!-- Search and Filter Bar -->
<form action="/items" method="GET" class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
    
    <!-- Semantic / Keyword Search Input -->
    <div class="lg:col-span-5">
      <label for="search" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        AI Semantic Search
      </label>
      <input
        type="text"
        id="search"
        name="search"
        value="<%= locals.searchTerm || '' %>"
        placeholder="e.g., cutting vegetables, cold drink..."
        class="w-full px-3.5 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
      />
    </div>

    <!-- Category Filter -->
    <div class="lg:col-span-3">
      <label for="category" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        Category
      </label>
      <select
        id="category"
        name="category"
        class="w-full px-3.5 py-2 text-sm border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
      >
        <option value="">All Categories</option>
        <% (locals.categories || []).forEach(cat => { %>
          <option value="<%= cat.id %>" <%= String(locals.selectedCategory || '') === String(cat.id) ? 'selected' : '' %>>
            <%= cat.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <!-- Max Price Filter -->
    <div class="lg:col-span-2">
      <label for="maxPrice" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        Max Price ($)
      </label>
      <input
        type="number"
        id="maxPrice"
        name="maxPrice"
        min="0"
        step="0.01"
        value="<%= locals.maxPrice || '' %>"
        placeholder="Any"
        class="w-full px-3.5 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
      />
    </div>

    <!-- Action Buttons -->
    <div class="lg:col-span-2 flex items-center gap-2">
      <button
        type="submit"
        class="w-full px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer"
      >
        Filter
      </button>
      <% if (locals.searchTerm || locals.selectedCategory || locals.maxPrice) { %>
        <a
          href="/items"
          class="px-3 py-2 text-sm font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition"
          title="Reset Filters"
        >
          Reset
        </a>
      <% } %>
    </div>

  </div>
</form>

    
   <!-- Inventory Data Table or Empty State -->
    <% if (items && items.length > 0) { %>
      <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-[750px] w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Category</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Stock</th>
                <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              
              <% items.forEach(item => { %>
                <tr class="hover:bg-gray-50 transition">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <div class="flex items-center gap-2">
                      <span><%= item.name %></span>
                      <% if (locals.searchTerm && item.similarity) { %>
                        <span class="px-2 py-0.5 text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-full">
                          <%= Math.round(item.similarity * 100) %>% match
                        </span>
                      <% } %>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= item.description || 'No description' %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <span class="px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">
                      <%= item.category_name || 'Uncategorized' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$<%= Number(item.price).toFixed(2) %></td>
                  
                  <!-- Stock Status Badge -->
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <% if (item.stock_count === 0) { %>
                      <span class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-800 rounded-full inline-flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span> Out of Stock
                      </span>
                    <% } else if (item.stock_count <= 5) { %>
                      <span class="px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-800 rounded-full inline-flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Low Stock (<%= item.stock_count %> left)
                      </span>
                    <% } else { %>
                      <span class="px-2.5 py-1 text-xs font-semibold bg-green-100 text-green-800 rounded-full inline-flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span> <%= item.stock_count %> in stock
                      </span>
                    <% } %>
                  </td>

                  <!-- Action Buttons with Icons -->
                                 <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <% if (canManage) { %>
                      <div class="flex items-center justify-end space-x-2">
                        <!-- Edit Button -->
                        <a href="/items/<%= item.id %>/edit" class="inline-flex items-center p-1.5 text-indigo-600 hover:text-indigo-900 hover:bg-indigo-50 rounded-lg transition" title="Edit Item">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                        </a>  
                        <!-- Delete Form & Button -->
                        <form action="/items/<%= item.id %>?_method=DELETE" method="POST" class="inline">
                          <button type="submit" class="inline-flex items-center p-1.5 text-red-600 hover:text-red-900 hover:bg-red-50 rounded-lg transition cursor-pointer" title="Delete Item" onclick="return confirm('Are you sure you want to delete this item?');">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                          </button>
                        </form>
                      </div>
                    <% } else { %>
                      <span class="text-xs text-gray-400 italic">View only</span>
                    <% } %>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center shadow-sm">
        <% if ((locals.searchTerm && locals.searchTerm.trim() !== "") || locals.selectedCategory || locals.maxPrice) { %>
          <p class="text-gray-900 font-semibold text-base">No matching items found for "<%= searchTerm %>"</p>
          <p class="text-gray-500 text-sm mt-1">Try searching with different keywords, a broader description, or check for typos.</p>
          <a href="/items" class="mt-4 inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition">
            Clear Search &amp; View All Items
          </a>
        <% } else { %>
          <p class="text-gray-500 text-sm">No items found in inventory.</p>
 <% if (canManage) { %>
            <a href="/items/new" class="mt-4 inline-block text-indigo-600 font-medium hover:underline text-sm">Create your first item &rarr;</a>
          <% } %>
       <% } %>
      </div>
    <% } %>


   <!-- Pagination Bar -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="mt-6 flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 rounded-xl shadow-sm border">
        <div class="flex flex-1 justify-between sm:hidden">
          <% if (currentPage > 1) { %>
            <a href="/items?page=<%= currentPage - 1 %><%= locals.filterQuery || '' %>" class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Previous</a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/items?page=<%= currentPage + 1 %><%= locals.filterQuery || '' %>" class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Next</a>
          <% } %>
        </div>

        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-gray-700">
              Showing page <span class="font-medium"><%= currentPage %></span> of <span class="font-medium"><%= totalPages %></span>
            </p>
          </div>
          <div>
            <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
              <% if (currentPage > 1) { %>
                <a href="/items?page=<%= currentPage - 1 %><%= locals.filterQuery || '' %>" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                  &larr; Prev
                </a>
              <% } %>

              <% for(let i = 1; i <= totalPages; i++) { %>
                <% if (i === currentPage) { %>
                  <a href="/items?page=<%= i %><%= locals.filterQuery || '' %>" class="relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white"><%= i %></a>
                <% } else { %>
                  <a href="/items?page=<%= i %><%= locals.filterQuery || '' %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= i %></a>
                <% } %>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="/items?page=<%= currentPage + 1 %><%= locals.filterQuery || '' %>" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                  Next &rarr;
                </a>
              <% } %>
            </nav>
          </div>
        </div>
      </div>
    <% } %>


  </main>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>
</body>
</html>
