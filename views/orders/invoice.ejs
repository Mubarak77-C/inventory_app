<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice — Order #<%= order.id %></title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 760px; margin: 2rem auto; padding: 0 1rem; color: #111827; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .btn { padding: 0.45rem 0.85rem; border-radius: 6px; border: 1px solid #9ca3af; background: #f3f4f6; color: #111827; text-decoration: none; cursor: pointer; font-size: 0.92rem; }
    .btn-primary { background: #111827; color: #fff; border-color: #111827; }
    .invoice-box { border: 1px solid #d1d5db; border-radius: 8px; padding: 1.5rem; background: #fff; }
    .header-grid { display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; border-bottom: 1px solid #e5e7eb; padding-bottom: 1rem; margin-bottom: 1.25rem; }
    table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
    th, td { border-bottom: 1px solid #e5e7eb; padding: 0.6rem; text-align: left; }
    th { background: #f9fafb; }
    .num { text-align: right; }
    .total-row td { font-weight: 700; font-size: 1.05rem; border-top: 2px solid #111827; border-bottom: none; }
    @media print {
      .toolbar { display: none; }
      body { margin: 0; max-width: 100%; }
      .invoice-box { border: none; padding: 0; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <a class="btn" href="/orders">&larr; Back to Orders</a>
    <button type="button" class="btn btn-primary" onclick="window.print()">Print Invoice</button>
  </div>

  <div class="invoice-box">
    <div class="header-grid">
      <div>
        <h2 style="margin: 0 0 0.35rem;">POS Invoice — Order #<%= order.id %></h2>
        <div><strong>Status:</strong> <%= order.status %> (<%= order.payment_status || "UNPAID" %>)</div>
        <% if (order.payment_method) { %>
          <div><strong>Payment Method:</strong> <%= order.payment_method %><%= order.payment_reference ? " · Ref: " + order.payment_reference : "" %></div>
        <% } %>
        <div><strong>Date:</strong> <%= new Date(order.created_at).toLocaleString() %></div>
      </div>

      <div>
        <h3 style="margin: 0 0 0.35rem;">Billed To</h3>
        <% if (order.customer_name) { %>
          <div><strong><%= order.customer_name %></strong></div>
          <% if (order.customer_phone) { %><div>Phone: <%= order.customer_phone %></div><% } %>
          <% if (order.customer_email) { %><div>Email: <%= order.customer_email %></div><% } %>
          <% if (order.customer_address_line1) { %><div><%= order.customer_address_line1 %></div><% } %>
          <% if (order.customer_address_line2) { %><div><%= order.customer_address_line2 %></div><% } %>
          <% if (order.customer_extra_details) { %><div><em>Notes / Details:</em> <%= order.customer_extra_details %></div><% } %>
        <% } else { %>
          <div>Walk-in Guest</div>
        <% } %>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th class="num">Unit Price</th>
          <th class="num">Qty</th>
          <th class="num">Line Total</th>
        </tr>
      </thead>
      <tbody>
        <% (items || []).forEach((line) => { %>
          <tr>
            <td><%= line.item_name %></td>
            <td class="num">$<%= Number(line.unit_price).toFixed(2) %></td>
            <td class="num"><%= line.quantity %></td>
            <td class="num">$<%= Number(line.line_total).toFixed(2) %></td>
          </tr>
        <% }) %>
        <tr class="total-row">
          <td colspan="3" class="num">Grand Total</td>
          <td class="num">$<%= Number(order.total_amount).toFixed(2) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</body>
</html>