<!-- views/partials/header.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'Inventory App' %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <!-- Navigation Bar -->
    <nav
      class="bg-slate-800 text-white px-6 py-4 shadow-md flex items-center justify-between"
    >
      <div class="flex space-x-6 font-medium text-sm">
        <a href="/items" class="hover:text-indigo-300 transition"
          >📦 Inventory Dashboard</a
        >
          <% if (currentUser) { %>
          <a href="/items/new" class="hover:text-indigo-300 transition"
            >+ Add Item</a
          >
        <% } %>
        <a href="/categories" class="hover:text-indigo-300 transition"
          >📂 Categories</a
        >
        <a
          href="/items/restock-advisor"
          class="hover:text-indigo-300 transition"
          >🤖 AI Restock Advisor</a
        >
        <a href="/items/chatbot" class="hover:text-indigo-300 transition"
          >💬 AI Chatbot</a
        >
      </div>

      <!-- Right-side Auth Section -->
      <div class="flex items-center space-x-4 text-sm">
        <% if (currentUser) { %>
          <span
            class="bg-indigo-500/20 border border-indigo-400/40 text-indigo-200 px-3 py-1 rounded-full text-xs font-medium"
          >
            🛡️ Admin: <%= currentUser.username %>
          </span>
          <form action="/logout" method="POST" class="inline">
            <button
              type="submit"
              class="bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer"
            >
              Logout
            </button>
          </form>
        <% } else { %>
          <a
            href="/login"
            class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-1.5 rounded-lg text-xs font-semibold transition"
          >
            Admin Login
          </a>
        <% } %>
      </div>
    </nav>
    <main class="max-w-6xl mx-auto px-4 py-6"></main>
  </body>
</html>
