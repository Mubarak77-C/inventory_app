<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
  <script src="https://tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-xl p-8 shadow-xl">
    <h1 class="text-2xl font-bold mb-2">Admin Sign In</h1>
    <p class="text-slate-400 text-sm mb-6">Sign in to manage inventory items and categories.</p>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/40 text-red-300 px-4 py-3 rounded-lg mb-4 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Username</label>
        <input type="text" name="username" required class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg focus:outline-none focus:border-indigo-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Password</label>
        <input type="password" name="password" required class="w-full px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg focus:outline-none focus:border-indigo-500" />
      </div>
      <button type="submit" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 font-semibold rounded-lg transition">
        Sign In
      </button>
    </form>
  </div>
</body>
</html>
