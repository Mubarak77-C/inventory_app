<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.title || 'Page Not Found' %></title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background-color: #f9fafb;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }
      .card {
        max-width: 28rem;
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        padding: 2rem;
        text-align: center;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: 9999px;
        background-color: #fef2f2;
        color: #dc2626;
        font-weight: 700;
        font-size: 1.125rem;
        margin-bottom: 1rem;
      }
      h1 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
      }
      p {
        font-size: 0.875rem;
        color: #6b7280;
        margin-top: 0.5rem;
        line-height: 1.5;
      }
      .actions {
        margin-top: 1.5rem;
        display: flex;
        justify-content: center;
        gap: 0.75rem;
      }
      .btn-primary {
        padding: 0.5rem 1rem;
        background-color: #4f46e5;
        color: #ffffff;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        text-decoration: none;
      }
      .btn-primary:hover {
        background-color: #4338ca;
      }
      .btn-secondary {
        padding: 0.5rem 1rem;
        background-color: #f3f4f6;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        text-decoration: none;
      }
      .btn-secondary:hover {
        background-color: #e5e7eb;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="badge">404</div>
      <h1><%= locals.heading || 'Not Found' %></h1>
      <p><%= locals.message || 'Resource not found.' %></p>
      <div class="actions">
        <a href="/items" class="btn-primary">Back to Dashboard</a>
        <a href="/categories" class="btn-secondary">View Categories</a>
      </div>
    </div>
  </body>
</html>
