<!-- views/categories.ejs -->
<%- include('partials/header', { title: 'Category Management' }) %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">📂 Category Management</h1>
  <p class="text-sm text-gray-500 mt-1">Organize your operational departments and menu sections.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  
  <!-- Left Column: Add Category Form -->
  <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm h-fit">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Add New Category</h2>
    <form action="/categories" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1" for="name">Category Name:</label>
        <input type="text" id="name" name="name" placeholder="e.g. Bar & Beverages" required 
               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1" for="description">Description:</label>
        <textarea id="description" name="description" rows="3" placeholder="Brief details about this category..."
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm"></textarea>
      </div>

      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-4 rounded-lg text-sm font-medium transition cursor-pointer">
        Create Category
      </button>
    </form>
  </div>

  <!-- Right Column: Existing Categories Table -->
  <div class="lg:col-span-2">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Existing Categories</h2>
    <% if (categories && categories.length > 0) { %>
      <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Quick Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% categories.forEach(category => { %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= category.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= category.description || 'No description' %></td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <a href="/categories/<%= category.id %>/items" class="text-indigo-600 hover:text-indigo-900 font-medium">View Items &rarr;</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500 text-sm">
        No categories found. Create your first one using the form!
      </div>
    <% } %>
  </div>

</div>

<%- include('partials/footer') %>