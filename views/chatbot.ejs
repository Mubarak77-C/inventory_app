<!-- views/chatbot.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col justify-between">

  <div>
    <%- include('partials/header', { title: title }) %>

    <main class="max-w-4xl mx-auto px-4 py-8">
      
      <!-- Header & Clear History Button -->
      <div class="mb-6 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">💬 AI Inventory Chatbot & History</h1>
          <p class="text-sm text-gray-500 mt-1">Persistent session log with timestamped database snapshots.</p>
        </div>
        <div class="flex items-center gap-3">
          <% if (history && history.length > 0) { %>
            <form action="/items/chatbot/clear" method="POST">
              <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-2 rounded-lg text-xs font-semibold transition cursor-pointer">
                🗑️ Clear History
              </button>
            </form>
          <% } %>
          <a href="/items" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition">
            &larr; Dashboard
          </a>
        </div>
      </div>

      <!-- Chat History Container -->
      <div id="chat-container" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6 h-[500px] overflow-y-auto flex flex-col space-y-6">
        
        <% if (!history || history.length === 0) { %>
          <div class="text-center py-20 text-gray-400 text-sm">
            <p>No chat history yet. Ask a question below to start the session!</p>
            <div class="flex flex-wrap justify-center gap-2 mt-4">
              <button onclick="setQuery('What items are out of stock?')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full transition">"What items are out of stock?"</button>
              <button onclick="setQuery('What is our most expensive item?')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full transition">"What is our most expensive item?"</button>
            </div>
          </div>
        <% } else { %>
          <% history.forEach(chat => { %>
            <div class="flex flex-col space-y-3">
              <!-- Timestamp Header -->
              <div class="text-center">
                <span class="text-[10px] text-gray-400 bg-gray-100 px-2.5 py-0.5 rounded-full">
                  <%= new Date(chat.created_at).toLocaleString() %>
                </span>
              </div>

              <!-- User Bubble -->
              <div class="self-end bg-indigo-600 text-white px-4 py-2.5 rounded-2xl rounded-tr-none text-sm max-w-lg shadow-sm">
                <%= chat.user_question %>
              </div>

              <!-- AI Response Bubble -->
              <div class="self-start bg-gray-50 text-gray-800 px-4 py-3 rounded-2xl rounded-tl-none text-sm max-w-2xl shadow-sm border border-gray-200 whitespace-pre-line leading-relaxed">
                <span class="font-semibold block mb-1 text-indigo-600">🤖 Gemini Assistant</span>
                <%= chat.ai_response %>
                
                <% if (chat.inventory_snapshot) { %>
                  <div class="mt-2 pt-2 border-t border-gray-200 text-[11px] text-gray-400 flex items-center gap-1">
                    <span>📌 Snapshot context: <%= chat.inventory_snapshot.itemCount || 0 %> total tracked records at query time</span>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>

      </div>

      <!-- Input Form -->
      <form action="/items/chatbot" method="POST" class="flex gap-3">
        <input type="text" name="question" id="questionInput" placeholder="Ask a question about your inventory..." required
               class="flex-1 px-4 py-3 border border-gray-300 rounded-xl text-sm focus:ring-indigo-500 focus:border-indigo-500 shadow-sm">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl text-sm font-medium shadow-sm transition cursor-pointer">
          Send 🚀
        </button>
      </form>

    </main>
  </div>

  <script>
    // Auto-scroll chat box to bottom on load
    const chatContainer = document.getElementById('chat-container');
    chatContainer.scrollTop = chatContainer.scrollHeight;

    function setQuery(text) {
      document.getElementById('questionInput').value = text;
      document.getElementById('questionInput').focus();
    }
  </script>

  <%- include('partials/footer') %>
</body>
</html>