<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.title || 'Page Not Found' %></title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background-color: #f9fafb;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }
      .card {
        max-width: 28rem;
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        padding: 2rem;
        text-align: center;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: 9999px;
        background-color: #fef2f2;
        color: #dc2626;
        font-weight: 700;
        font-size: 1.125rem;
        margin-bottom: 1rem;
      }
      h1 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
      }
      p {
        font-size: 0.875rem;
        color: #6b7280;
        margin-top: 0.5rem;
        line-height: 1.5;
      }
      .actions {
        margin-top: 1.5rem;
        display: flex;
        justify-content: center;
        gap: 0.75rem;
      }
      .btn-primary {
        padding: 0.5rem 1rem;
        background-color: #4f46e5;
        color: #ffffff;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        text-decoration: none;
      }
      .btn-primary:hover {
        background-color: #4338ca;
      }
      .btn-secondary {
        padding: 0.5rem 1rem;
        background-color: #f3f4f6;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        text-decoration: none;
      }
      .btn-secondary:hover {
        background-color: #e5e7eb;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="badge">404</div>
      <h1><%= locals.heading || 'Not Found' %></h1>
      <p><%= locals.message || 'Resource not found.' %></p>
      <div class="actions">
        <a href="/items" class="btn-primary">Back to Dashboard</a>
        <a href="/categories" class="btn-secondary">View Categories</a>
      </div>
    </div>
  </body>
</html>
</file>

<file path="views/categories.ejs">
<%- include('partials/header', { title: title }) %>
<% const canManage = Boolean(currentUser && ["admin", "superadmin"].includes(currentUser.role)); %>

<div class="max-w-6xl mx-auto px-4 py-8">
  
  <!-- Page Header -->
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">📂 <%= title %></h1>
    <p class="text-sm text-gray-500 mt-1">Organize your operational departments and menu sections.</p>
  </div>

  <!-- Category Summary Metric Card -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Total Categories</p>
      <p class="text-2xl font-bold text-gray-900 mt-1">
        <%= categories ? categories.length : 0 %>
      </p>
    </div>
    <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Management Status</p>
      <p class="text-sm font-medium text-indigo-600 mt-2 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Active & Linked
      </p>
    </div>
  </div>

<!-- views/categories.ejs -->

<!-- 
<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">📂 Category Managementcc</h1>
  <p class="text-sm text-gray-500 mt-1">Organize your operational departments and menu sections.</p>
</div> -->
<div class="grid grid-cols-1 <%= (currentUser && currentUser.role === 'admin') ? 'lg:grid-cols-3' : '' %> gap-8">

  <% if (canManage) { %>
    <!-- Left Column: Add Category Form -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm h-fit">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Add New Category</h2>
      <form action="/categories" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="name">Category Name:</label>
          <input type="text" id="name" name="name" placeholder="e.g. Bar & Beverages" required 
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="description">Description:</label>
          <textarea id="description" name="description" rows="3" placeholder="Brief details about this category..."
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm"></textarea>
        </div>

        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-4 rounded-lg text-sm font-medium transition cursor-pointer">
          Create Category
        </button>
      </form>
    </div>
  <% } %>

  <!-- Right Column: Existing Categories Table -->
  <div class="lg:col-span-2">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Existing Categories</h2>
    <% if (categories && categories.length > 0) { %>
      <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% categories.forEach(category => { %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= category.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= category.description || 'No description' %></td>
                
                <!-- Single aligned TD with icon buttons -->
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-3">
                    
                    <!-- View Items Button with Icon -->
                    <a href="/categories/<%= category.id %>/items" class="inline-flex items-center gap-1.5 text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg text-xs font-semibold transition">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                      </svg>
                      View Items
                    </a>
                    
                    <% if (canManage) { %>
                      <!-- Delete Form with Icon Button -->
                      <form action="/categories/<%= category.id %>?_method=DELETE" method="POST" class="inline">
                        <button type="submit" class="inline-flex items-center p-1.5 text-red-600 hover:text-red-900 hover:bg-red-50 rounded-lg transition cursor-pointer" title="Delete Category" onclick="return confirm('WARNING: Deleting this category will also delete ALL items assigned to it. Are you sure?');">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500 text-sm">
        No categories found. Create your first one using the form!
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
</file>

